---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/HeaderPost.astro";
import Footer from "../../../components/Footer.astro";
import { supabase } from "../../../lib/supabase";
import { marked } from "marked";

export async function getStaticPaths() {
  const { data: posts } = await supabase
    .from("posts")
    .select("slug, categoria")
    .eq("publicado", true)
    .not("categoria", "is", null);

  return (posts || []).map((p) => ({
    params: { categoria: p.categoria.toLowerCase(), slug: p.slug },
  }));
}

const { categoria, slug } = Astro.params;
const { data: post } = await supabase
  .from("posts")
  .select("*")
  .eq("slug", slug)
  .eq("categoria", categoria)
  .eq("publicado", true)
  .single();

if (!post) return Astro.redirect("/posts");

const contenidoHtml = post.contenido_md ? marked(post.contenido_md) : "";

const fecha = new Date(post.creado_en);
const fechaFormateada = `Publicado el ${fecha.getDate()}/${fecha.getMonth() + 1}/${fecha.getFullYear()}`;
---

<Layout
  title={`${post.titulo} | Queselló!`}
  description={post.resumen || post.subtitulo || post.titulo}
  image={post.imagen_url}
>
  <Header />
  <article
    style="max-width: 780px; margin: 0 auto; padding: 60px 20px; font-family: 'Inter', sans-serif;"
  >
    <a
      href="/posts"
      style="display: inline-flex; align-items: center; gap: 8px; color: #495D56; text-decoration: none; font-weight: 600; font-size: 14px; margin-bottom: 40px;"
    >
      ← Volver al blog
    </a>

    {
      post.imagen_url && (
        <img
          src={post.imagen_url}
          alt={post.titulo}
          style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 24px; margin-bottom: 40px;"
        />
      )
    }

    <span style="display: block; font-size: 12px; color: #64748B; font-weight: 500; margin-bottom: 8px;">
      {fechaFormateada}
    </span>
    <h1
      style="font-size: 36px; font-weight: 900; color: #1E293B; margin: 0 0 12px 0; line-height: 1.2;"
    >
      {post.titulo}
    </h1>

    {
      post.subtitulo && (
        <p style="font-size: 18px; color: #FF5E5E; font-weight: 600; margin: 0 0 20px 0;">
          {post.subtitulo}
        </p>
      )
    }

    {
      post.resumen && (
        <p style="font-size: 16px; color: #64748B; margin: 0 0 40px 0; line-height: 1.7; padding-bottom: 30px; border-bottom: 1px solid #F1F5F9;">
          {post.resumen}
        </p>
      )
    }

    <div class="post-content" set:html={contenidoHtml} />
  </article>
</Layout>
<Footer />
<style is:global>
  .post-content {
    font-size: 16px;
    line-height: 1.8;
    color: #334155;
    font-family: "Inter", sans-serif;
  }
  .post-content h2 {
    font-size: 26px;
    font-weight: 800;
    color: #1e293b;
    margin: 40px 0 16px;
  }
  .post-content h3 {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
    margin: 30px 0 12px;
  }
  .post-content p {
    margin: 0 0 20px;
  }
  .post-content a {
    color: #ff5e5e;
    font-weight: 600;
  }
  .post-content ul,
  .post-content ol {
    padding-left: 24px;
    margin: 0 0 20px;
  }
  .post-content li {
    margin-bottom: 8px;
  }
  .post-content img {
    width: 100%;
    border-radius: 16px;
    margin: 24px 0;
  }
  .post-content blockquote {
    background: #fef9c3;
    padding: 35px 40px;
    margin: 45px auto;
    border: none;
    border-radius: 2px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05), 5px 5px 15px rgba(0,0,0,0.05);
    transform: rotate(-1.5deg);
    font-family: 'Indie Flower', cursive;
    font-size: 22px;
    color: #4b3b28;
    position: relative;
    max-width: 90%;
    line-height: 1.4;
    text-align: center !important;
  }
  .post-content blockquote:nth-of-type(even) {
    transform: rotate(1.5deg);
    background: #fff5f5;
  }
  .post-content blockquote::after {
    content: "";
    position: absolute;
    bottom: 0;
    right: 0;
    border-width: 25px 25px 0 0;
    border-style: solid;
    border-color: rgba(0,0,0,0.05) #fff;
    display: block;
    width: 0;
  }
  .post-content blockquote p {
    margin: 0 !important;
    text-align: center !important;
    font-style: normal !important;
  }
  .post-content code {
    background: #f1f5f9;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 14px;
  }
  .post-content pre {
    background: #1e293b;
    color: #e2e8f0;
    padding: 20px;
    border-radius: 16px;
    overflow-x: auto;
    margin: 24px 0;
  }
</style>
