---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { supabase } from "../lib/supabase";

const title = "¡Gracias por tu pedido! - Queselló";
const description = "Tu pedido fue registrado con éxito. Informá tu pago o seguí el estado de tu pedido en tiempo real.";

let franchise = { id: 1, nombre: "Central Queselló", whatsapp: "5492235203360" };
try {
	const { data: centralFranchise } = await supabase
		.from("franquicias")
		.select("*")
		.eq("id", 1)
		.single();
	if (centralFranchise) franchise = centralFranchise;
} catch (e) {
	// Fallback
}
const wpPhone = franchise.whatsapp || "5492235203360";
---

<Layout title={title} description={description}>
	<main class="w-full min-h-screen flex flex-col items-center overflow-x-hidden relative bg-[#EDE8D3]">
		
		<!-- TopNav y Header unificados (mismo sistema visual de /pedidos e index) -->
		<TopNav franchise={franchise} showCart={false} showLocation={false} />

		<div class="container text-center">
			<Header />
		</div>

		<!-- Sección principal SIN card, directamente sobre el fondo del sitio -->
		<section style="flex: 1; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 420px; padding: 0 16px 40px; text-align: center;">
			
			<div style="margin-bottom: 24px;">
				<h2 style="font-weight: 700; margin: 16px 0 8px; color: #FF5555; font-family: var(--font-outfit); font-size: 32px; line-height: 1.2;">
					¡Gracias!
				</h2>
				
				<div style="display: inline-flex; align-items: center; gap: 6px; background: white; border: 2px solid rgba(73, 93, 86, 0.15); padding: 6px 18px; border-radius: 24px; font-weight: 700; font-size: 14px; color: #495D56; margin-bottom: 14px;">
					<span>Pedido</span>
					<strong id="gracias-nro" style="color: #FF5555;">#00000</strong>
				</div>

				<p style="margin: 0 auto; font-size: 16px; opacity: 0.85; color: #495D56; line-height: 1.4; max-width: 360px;">
					Tu pedido está en proceso. Si pagaste informalo aquí, así completás el pedido.
				</p>
			</div>

			<!-- Acciones con la misma UI de botones del design system -->
			<div style="width: 100%; display: flex; flex-direction: column; gap: 12px;">
				
				<!-- Botón Principal: INFORMAR PAGO -->
				<a
					id="btn-informar-pago"
					href={`https://api.whatsapp.com/send?phone=${wpPhone}&text=${encodeURIComponent("Hola! Ya realicé el pago de mi pedido. Te adjunto el comprobante:")}`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn"
					style="width: 100%; margin: 0; background-color: #25D366; color: white; display: flex; align-items: center; justify-content: center; gap: 10px; height: 50px; border-radius: 25px; text-decoration: none; font-weight: 700; font-size: 16px; font-family: var(--font-outfit); box-shadow: 0 4px 14px rgba(37, 211, 102, 0.25);"
				>
					<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.155.57 4.177 1.564 5.927l-1.659 6.057 6.223-1.632c1.705.93 3.659 1.464 5.74 1.464 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
					</svg>
					INFORMAR PAGO
				</a>

				<!-- Botón Secundario: Seguimiento de pedidos (outline en estilo del design system) -->
				<a
					id="btn-seguimiento"
					href="/pedidos"
					class="btn"
					style="width: 100%; margin: 0; background: transparent; color: #FF5555; border: 2px solid #FF5555; display: flex; align-items: center; justify-content: center; gap: 8px; height: 50px; border-radius: 25px; text-decoration: none; font-weight: 700; font-size: 15px; font-family: var(--font-outfit);"
				>
					Seguimiento de pedidos
				</a>
			</div>

			<!-- Caja informativa de transferencia bancaria sobre fondo directo -->
			<div style="width: 100%; background: white; border: 2px solid rgba(73, 93, 86, 0.15); border-radius: 24px; padding: 18px 20px; margin-top: 24px; text-align: left; font-size: 14px; line-height: 1.5; color: #495D56;">
				<div style="font-weight: 700; color: #FF5555; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
					<span>💡</span> ¿Aún no realizaste la transferencia?
				</div>
				<div>Hacé la transferencia al alias: <strong style="background: #EDE8D3; padding: 2px 8px; border-radius: 8px; font-family: monospace; font-size: 14px; color: #2F3E39; user-select: all;">mi.sello</strong></div>
				<div style="margin-top: 6px; font-size: 12px; opacity: 0.8;">Una vez abonado, presioná &ldquo;INFORMAR PAGO&rdquo; para adjuntar tu comprobante.</div>
			</div>

			<a href="/" style="margin-top: 24px; font-size: 14px; font-weight: 600; color: #495D56; text-decoration: underline;">
				Volver al inicio
			</a>

		</section>

		<!-- Footer oficial unificado -->
		<div class="w-full max-w-[500px] mx-auto px-4 mt-auto">
			<Footer />
		</div>

	</main>
</Layout>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const urlParams = new URLSearchParams(window.location.search);
		const pedido = urlParams.get('pedido') || '';
		const cliente = urlParams.get('cliente') || '';
		const wpPhone = "5492235203360";

		if (pedido) {
			const elNro = document.getElementById('gracias-nro');
			if (elNro) elNro.innerText = `#${pedido}`;

			const btnSeguimiento = document.getElementById('btn-seguimiento');
			if (btnSeguimiento) {
				btnSeguimiento.href = `/pedidos?n=${encodeURIComponent(pedido)}`;
			}

			const btnWp = document.getElementById('btn-informar-pago');
			if (btnWp) {
				const msg = `Hola! Ya realicé el pago de mi pedido #${pedido}${cliente ? ' a nombre de ' + cliente : ''}. Te envío el comprobante:`;
				btnWp.href = `https://api.whatsapp.com/send?phone=${wpPhone}&text=${encodeURIComponent(msg)}`;
			}
		} else {
			const elNro = document.getElementById('gracias-nro');
			if (elNro) elNro.innerText = 'Registrado';
		}
	});
</script>
