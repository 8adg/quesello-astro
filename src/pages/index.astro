---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import Header from "../components/Header.astro";
import HeroSlider from "../components/HeroSlider.jsx";
import Franquicia from "../components/Franquicia.astro";
import OrderStatusCard from "../components/OrderStatusCard.astro";
import SlidersLoader from "../components/SlidersLoader.jsx";
import Footer from "../components/Footer.astro";
import { CartIcon, CartDrawer } from "../components/Cart.jsx";
import NewsletterModal from "../components/NewsletterModal.jsx";

import { supabase } from "../lib/supabase";

// Solo traemos la franquicia (dato estático, no cambia frecuentemente)
let loadingError = null;

try {
	const { data: centralFranchise } = await supabase.from('franquicias').select('*').eq('id', 1).single();
	var franchise = centralFranchise || { id: 1, nombre: 'Central Queselló', whatsapp: '5492235203360' };
} catch (err) {
	console.error('Landing Error:', err);
	loadingError = err.message;
}
---

<Layout>
	<main class="w-full min-h-screen flex flex-col items-center overflow-x-hidden relative">
		
		<TopNav franchise={franchise} />
		
		<div class="container text-center">
			<Header loading="eager" priority="high" />
			<HeroSlider client:load />
			<Franquicia />
		</div>
		
		<OrderStatusCard />

		<div style="width: 100%; max-width: 390px; margin: 10px auto 14px auto; padding: 0 16px; box-sizing: border-box;">
			<a
				href="/catalogo"
				style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-radius: 18px; background: #F4F1E1; border: 1px solid rgba(73, 93, 86, 0.25); box-shadow: 0 2px 8px rgba(0,0,0,0.04); text-decoration: none; box-sizing: border-box; gap: 12px;"
			>
				<div style="text-align: left;">
					<span style="display: block; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #FF5E5E; line-height: 1.2;">Guía interactiva por uso</span>
					<span style="display: block; font-size: 12px; font-weight: 800; color: #495D56; line-height: 1.3; margin-top: 2px;">Ver catálogo completo por tipo de empaque</span>
				</div>
				<span style="width: 28px; height: 28px; border-radius: 10px; background: #495D56; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; flex-shrink: 0;">→</span>
			</a>
		</div>

		<!-- CARRUSELES DINÁMICOS (cargados en cliente, siempre frescos) -->
		<div id="products-section" class="w-full overflow-hidden flex flex-col items-center">
			<SlidersLoader client:load />
		</div>

		<div class="w-full max-w-[500px] mx-auto px-4 mt-auto">
			<Footer />
		</div>
	</main>

	<CartIcon client:load franchise={franchise} />
	<CartDrawer client:load />
	<NewsletterModal client:load />
</Layout>
