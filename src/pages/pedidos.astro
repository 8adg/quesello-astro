---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import Header from "../components/Header.astro";
import OrderTracker from "../components/OrderTracker.jsx";
import Footer from "../components/Footer.astro";
import { supabase } from "../lib/supabase";

const title = "Estado de mi pedido - Queselló!";
// Traer data de la franquicia principal para consistencia en el Header
const { data: centralFranchise } = await supabase
	.from("franquicias")
	.select("*")
	.eq("id", 1)
	.single();
const franchise = centralFranchise || { id: 1, nombre: "Central Queselló", whatsapp: "5492235203360" };
---

<Layout title={title}>
	<main class="w-full min-h-screen flex flex-col items-center overflow-x-hidden relative">
		<!-- Header y Nav unificados con data real -->
		<TopNav
			franchise={franchise}
			showCart={false}
			showLocation={true}
		/>
		
		<div class="container text-center">
			<Header />
		</div>

		<section
			style="flex: 1; display: flex; flex-direction: column; align-items: center; padding-bottom: 40px; width: 100%; max-width: 500px; padding-left: 16px; padding-right: 16px;"
		>
			<OrderTracker client:load />
		</section>

		<section class="flex justify-center py-6">
			<img
				src="/pedido-ok.webp"
				alt="mi pedido"
				style="width: 200px; height: auto;"
			/>
		</section>

		<div class="w-full max-w-[500px] mx-auto px-4 mt-auto">
			<Footer />
		</div>
	</main>
</Layout>
