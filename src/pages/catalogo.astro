---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PublicCatalogView from "../components/PublicCatalogView.jsx";
import { CartIcon, CartDrawer } from "../components/Cart.jsx";
import { supabase } from "../lib/supabase";

let franchise = { id: 1, nombre: 'Central Queselló', whatsapp: '5492235203360' };
let initialProducts = [];

try {
	const { data: centralFranchise } = await supabase
		.from('franquicias')
		.select('*')
		.eq('id', 1)
		.single();
	if (centralFranchise) franchise = centralFranchise;

	const { data: prods } = await supabase
		.from('productos')
		.select('id, codigo, descripcion, precio, categoria, activo, data, foto_url, medida_ancho, medida_alto')
		.eq('activo', true)
		.order('categoria', { ascending: true })
		.order('precio', { ascending: true });
	if (prods) initialProducts = prods;
} catch (err) {
	console.error('Error loading catalogo:', err);
}
---

<Layout title="Catálogo Completo y Guía por Empaque | Queselló!">
	<main class="w-full min-h-screen flex flex-col items-center overflow-x-hidden relative">
		<TopNav franchise={franchise} />

		<div class="container text-center">
			<Header loading="eager" priority="high" />
		</div>

		<PublicCatalogView client:load initialProducts={initialProducts} />

		<div style="width: 100%; max-width: 500px; margin: auto auto 0 auto; padding: 0 16px; box-sizing: border-box;">
			<Footer />
		</div>
	</main>

	<CartIcon client:load franchise={franchise} />
	<CartDrawer client:load />
</Layout>

